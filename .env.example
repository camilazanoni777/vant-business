# Copie para .env.local e preencha. .env* esta no .gitignore.

# --- Atalho de login do painel em desenvolvimento local ---
# Sem estas duas, o atalho fica desativado e o login sempre usa /api/admin-login.
VITE_LOCAL_ADMIN_EMAIL=
VITE_LOCAL_ADMIN_PASSWORD=

# --- WhatsApp usado pelo formulario de diagnostico ---
VITE_VANT_WHATSAPP_NUMBER=

# --- Painel administrativo (/api/admin-*) ---
# Obrigatorias: sem as duas primeiras, o login administrativo fica desativado.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Segredo usado para assinar o cookie de sessao. Defina um valor longo e unico.
ADMIN_SESSION_SECRET=

# --- Backend (funcoes em /api) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
